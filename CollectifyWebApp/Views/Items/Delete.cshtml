@model CollectifyWebApp.Models.Item

<!-- ===== Main ===== -->
<main class="section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9">

                <div class="text-center mb-4" data-aos="fade-up">
                    <div class="section-label">Remove</div>
                    <h1 class="section-title mb-2">Delete Item</h1>
                    <p class="text-muted-2">Are you sure you want to remove this item?</p>
                </div>

                <div class="card-lux" data-aos="fade-up" data-aos-delay="60">
                    <div class="card-body p-4 p-md-5">

                        <div class="d-flex align-items-center gap-3 mb-4 pb-3" style="border-bottom:1px solid var(--border);">
                            @if (Model.Image != null)
                            {
                                <img src="@Model.Image/low.png" style="width:56px;border-radius:8px;" />
                            }
                            <div>
                                <div style="font-family:'Playfair Display',serif;font-size:1.15rem;">@Model.Name</div>
                                <div class="text-muted-2 small">@Model.Category</div>
                            </div>
                        </div>

                        <table class="table table-lux">
                            <tr>
                                <td class="text-muted-2">Purchase Price</td>
                                <td class="text-end">$@Model.PurchasePrice</td>
                            </tr>
                            <tr>
                                <td class="text-muted-2">Estimated Value</td>
                                <td class="text-end text-gold">$@Model.EstimatedValue</td>
                            </tr>
                            <tr>
                                <td class="text-muted-2">Date Added</td>
                                <td class="text-end">@Model.DateAdded.ToShortDateString()</td>
                            </tr>
                            @if (Model.Rarity != null)
                            {
                                <tr>
                                    <td class="text-muted-2">Rarity</td>
                                    <td class="text-end">@Model.Rarity</td>
                                </tr>
                            }
                        </table>

                        <div class="mt-3 mb-3 p-3" style="background:rgba(220,53,69,0.08);border-radius:10px;border:1px solid rgba(220,53,69,0.2);">
                            <p class="mb-0 small" style="color:#dc3545;">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                This action cannot be undone. This item will be permanently removed from your collection.
                            </p>
                        </div>

                        <form asp-action="Delete" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div class="d-flex flex-wrap gap-2 mt-4">
                                <button type="submit" class="btn btn-danger-soft flex-fill">
                                    <i class="bi bi-trash me-1"></i> Delete Permanently
                                </button>
                                <a asp-action="Index" class="btn btn-ghost flex-fill">Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</main>