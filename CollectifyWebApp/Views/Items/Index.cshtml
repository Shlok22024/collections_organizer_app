@model IEnumerable<CollectifyWebApp.Models.Item>

<!-- ===== Main ===== -->
<main class="section">
    <div class="container">

        <div class="d-flex flex-wrap align-items-end justify-content-between mb-4" data-aos="fade-up">
            <div>
                <div class="section-label">Inventory</div>
                <h1 class="section-title mb-2">Your Items</h1>
                <p class="text-muted-2 mb-0">Browse every piece across your collections.</p>
            </div>
            <a asp-action="Create" class="btn btn-gold mt-3 mt-md-0">
                <i class="bi bi-plus-circle me-1"></i> Add Item
            </a>
        </div>

        <!-- Search + filters -->
        <div class="row g-3 align-items-center mb-4" data-aos="fade-up" data-aos-delay="60">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" placeholder="Search items by name, category, or value..." aria-label="Search items">
                    <button type="button" class="btn btn-gold">
                        <i class="bi bi-search me-1"></i> Search
                    </button>
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select" aria-label="Filter by category">
                    <option selected>All categories</option>
                    <option>Cards</option>
                    <option>Vinyl</option>
                    <option>Figurines</option>
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select" aria-label="Sort order">
                    <option selected>Newest</option>
                    <option>Value (high to low)</option>
                    <option>Value (low to high)</option>
                </select>
            </div>
        </div>

        <!-- Table -->
        <div class="table-wrap" data-aos="fade-up" data-aos-delay="120">
            <div class="table-responsive">
                <table class="table table-lux align-middle">
                    <thead>
                        <tr>
                            <th scope="col" style="width:56px;"></th>
                            <th scope="col">Item Name</th>
                            <th scope="col">Category</th>
                            <th scope="col" class="text-end">Purchase Price</th>
                            <th scope="col" class="text-end">Estimated Value</th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted-2">No items yet. Add your first item!</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @if (item.Image != null)
                                        {
                                            <img src="@item.Image/low.png" style="width:40px;" />
                                        }
                                    </td>
                                    <td>@item.Name</td>
                                    <td><span class="badge-cat">@item.Category</span></td>
                                    <td class="text-end">$@item.PurchasePrice</td>
                                    <td class="text-end text-gold">$@item.EstimatedValue</td>
                                    <td class="text-end">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-icon" title="Edit"><i class="bi bi-pencil-square"></i></a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn-icon" title="Delete"><i class="bi bi-trash"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="text-muted-2 small">Showing @Model.Count() items</div>
        </div>

    </div>
</main>